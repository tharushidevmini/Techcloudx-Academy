# ==============================================================================
# TechCloudX Academy - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and update the values with your local/production settings.
# DO NOT commit '.env' to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="TechCloudX Academy"
API_V1_STR="/api/v1"

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=techcloudx_academy
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# PostgreSQL Connection Strings
# For Docker internal communication:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# For local host debugging directly without Docker networking:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# JWT Authentication & Cryptography
JWT_SECRET_KEY=generate_a_super_secret_64_character_hex_key_here_for_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Service
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security & CORS (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
